# Core PassivePress agent runtime
CONVEX_SITE_URL=https://passivepress.qzz.io
PUBLIC_SITE_URL=https://passivepress.qzz.io
CLIPROXY_BASE_URL=http://localhost:8317/v1
CLIPROXY_API_KEY=
CLIPROXY_LLM_MODEL=gemini-3-flash
TELEGRAM_TOKEN=
CHAT_ID=

# Social media agent
SOCIAL_BRAND_NAME=PassivePress
SOCIAL_BRAND_FOOTER=#PassivePress | passivepress.qzz.io
SOCIAL_DEFAULT_PLATFORMS=x,instagram,facebook,linkedin,pinterest
SOCIAL_MAX_RETRIES=2
SOCIAL_RETRY_BACKOFF_MS=2000
SOCIAL_ENABLE_TELEGRAM_ALERTS=true

SOCIAL_ENABLE_X=true
SOCIAL_ENABLE_INSTAGRAM=true
SOCIAL_ENABLE_FACEBOOK=true
SOCIAL_ENABLE_LINKEDIN=true
SOCIAL_ENABLE_PINTEREST=true

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# RainforestAPI-backed Amazon product data
RAINFOREST_API_KEY=
RAINFOREST_AMAZON_DOMAIN=amazon.com
RAINFOREST_CUSTOMER_LOCATION=
RAINFOREST_CUSTOMER_ZIPCODE=
RAINFOREST_LANGUAGE=
RAINFOREST_CURRENCY=USD
RAINFOREST_REQUEST_TIMEOUT_MS=30000

# Amazon affiliate links
AMAZON_ASSOCIATE_TAG=yourstore-20
AMAZON_MARKETPLACE=www.amazon.com

# Deprecated: Amazon PA API credentials are not required for normal PassivePress runtime.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=us-east-1

# Niche config
AFFILIATE_NICHES=tech,home-appliances,fitness
AFFILIATE_DEFAULT_NICHE=tech
PRODUCT_CACHE_TTL_HOURS=24
