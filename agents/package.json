  },
  "dependencies": {
    "sharp": "^0.33.5",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.7.0",
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "playwright": "^1.54.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@types/uuid": "^9.0.8"
  }
}
