{
  "name": "passivepress-agents",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "run": "tsx pipeline.ts",
    "dry-run": "tsx pipeline.ts --dry-run",
    "batch": "tsx pipeline.ts --count 3",
    "test:trend": "tsx agents/1-trend-scout.ts",
    "test:picker": "tsx agents/2-topic-picker.ts",
    "test:image": "tsx agents/3-image-gen.ts",
    "test:writer": "tsx agents/4-writer.ts",
    "test:researcher": "tsx agents/3-product-researcher.ts",
    "test:dataviz": "tsx agents/9-dataviz.ts",
    "test:convex": "tsx lib/convex-client.ts",
    "test:skills": "tsx -e \"import { listSkills } from './lib/skill-loader.ts'; console.log('Skills:', listSkills());\"",
    "meta": "tsx agents/6-meta-agent.ts",
    "meta:report": "tsx agents/6-meta-agent.ts --report-only",
    "meta:auto": "tsx agents/6-meta-agent.ts --apply-all",
    "test:affiliate-linker": "tsx agents/7-affiliate-linker.ts",
